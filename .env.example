# AI Review - Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# Anthropic API
# ===========================================
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ===========================================
# GitHub Configuration
# ===========================================
GITHUB_TOKEN=github_pat_your-token-here
GITHUB_WEBHOOK_SECRET=your-webhook-secret-from-openssl-rand-hex-32

# ===========================================
# Smee.io Webhook Proxy (for local development)
# ===========================================
SMEE_URL=https://smee.io/your-channel-id

# ===========================================
# MongoDB Configuration
# ===========================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_review

# ===========================================
# Server Configuration
# ===========================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ===========================================
# Review Configuration
# ===========================================
# Default review level if not specified: light, deep, auto
DEFAULT_REVIEW_LEVEL=auto